# LaTeX Suite-style shortcuts for VS Code HyperSnips.
# Shortcut reference and upstream attribution: README.md in this directory.
# All placeholders use bare $1, $2, ... because HyperSnips 0.2.9 does not
# track default-valued placeholders reliably. Escape leaves a snippet.
global
const vscode = require("vscode");
let cachedState;
const mathEnvironments = new Set([
    "math", "displaymath", "equation", "eqnarray", "align", "alignat",
    "flalign", "gather", "multline", "aligned", "alignedat", "gathered",
    "split", "matrix", "pmatrix", "bmatrix", "Bmatrix", "vmatrix",
    "Vmatrix", "smallmatrix", "cases", "array", "IEEEeqnarray", "notederivation"
]);
const codeEnvironments = new Set(["verbatim", "Verbatim", "lstlisting", "minted", "notecode"]);
const textCommands = new Set([
    "text", "textrm", "textsf", "texttt", "textnormal", "textbf", "textit",
    "mbox", "hbox", "operatorname", "mathrm", "label", "ref", "eqref",
    "cite", "url", "path", "tag"
]);

// TextMate does not know that keyequation's second argument and a
// notederivation's body contain math. Track those alongside ordinary TeX
// delimiters, nested groups, text arguments, comments, and verbatim regions.
function scanLatex(before) {
    const frames = [{ kind: "root", mode: "text" }];
    let pending = [];
    const current = () => frames[frames.length - 1];
    const close = (kind, name) => {
        for (let j = frames.length - 1; j > 0; j--) {
            if (frames[j].kind === kind && frames[j].name === name) {
                frames.length = j;
                break;
            }
        }
    };
    for (let i = 0; i < before.length;) {
        if (current().mode === "code") {
            const end = "\\end{" + current().name + "}";
            const next = before.indexOf(end, i);
            if (next === -1) return { mode: "code", command: false };
            i = next + end.length;
            frames.pop();
            continue;
        }
        const ch = before[i];
        if (ch === "%") {
            const next = before.indexOf("\n", i);
            if (next === -1) return { mode: "comment", command: false };
            i = next + 1;
            continue;
        }
        if (ch === "\\") {
            const tail = before.slice(i);
            const environment = /^\\(begin|end)\s*\{([^}]+)\}/.exec(tail);
            if (environment) {
                const name = environment[2];
                const base = name.replace(/\*$/, "");
                pending = [];
                if (environment[1] === "end") {
                    close("environment", name);
                } else {
                    const mode = codeEnvironments.has(base) ? "code"
                        : mathEnvironments.has(base) ? "math" : current().mode;
                    frames.push({ kind: "environment", name, mode });
                    if (base === "notederivation") {
                        pending = ["text"];
                        const after = before.slice(i + environment[0].length);
                        const optionStart = /^\s*\[/.exec(after);
                        if (optionStart) {
                            const optionEnd = after.indexOf("]", optionStart[0].length);
                            if (optionEnd === -1) return {mode:"text", command:/\\[A-Za-z@]*$/.test(before)};
                            const options = after.slice(optionStart[0].length, optionEnd);
                            if (/\bmode\s*=\s*steps\b/.test(options)) current().mode = "text";
                            i += optionEnd + 1;
                        }
                    }
                }
                i += environment[0].length;
                continue;
            }
            const verb = /^\\verb\*?([^A-Za-z\s])/.exec(tail);
            if (verb) {
                const next = before.indexOf(verb[1], i + verb[0].length);
                if (next === -1) return { mode: "code", command: false };
                i = next + 1;
                continue;
            }
            const symbol = before[i + 1];
            if (symbol === "(" || symbol === "[") {
                frames.push({ kind: "delimiter", name: symbol, mode: "math" });
                pending = [];
                i += 2;
                continue;
            }
            if (symbol === ")" || symbol === "]") {
                close("delimiter", symbol === ")" ? "(" : "[");
                pending = [];
                i += 2;
                continue;
            }
            const command = /^\\([A-Za-z@]+)\*?/.exec(tail);
            if (command) {
                const name = command[1];
                if (name === "derivestep") {
                    const derivation = frames.findLast(frame => frame.kind === "environment" && frame.name === "notederivation");
                    if (derivation) derivation.mode = "text";
                }
                pending = name === "keyequation" ? ["text", "math"]
                    : name === "derivestep" ? ["math", "text"]
                    : name === "ensuremath" ? ["math"]
                    : textCommands.has(name) ? ["text"] : [];
                i += command[0].length;
                continue;
            }
            // Escaped dollars, braces, percent signs, and row breaks are literal.
            i += 2;
            continue;
        }
        if (ch === "$") {
            const name = before[i + 1] === "$" ? "$$" : "$";
            if (current().kind === "delimiter" && current().name === name) {
                frames.pop();
            } else {
                frames.push({ kind: "delimiter", name, mode: "math" });
            }
            pending = [];
            i += name.length;
            continue;
        }
        if (ch === "{") {
            frames.push({ kind: "group", mode: pending.length ? pending[0] : current().mode,
                after: pending.slice(1) });
            pending = [];
        } else if (ch === "}") {
            if (current().kind === "group") pending = frames.pop().after;
            else pending = [];
        } else if (!/\s/.test(ch)) {
            pending = [];
        }
        i++;
    }
    return { mode: current().mode, command: /\\[A-Za-z@]*$/.test(before) };
}

function state(context) {
    const editor = vscode.window.activeTextEditor;
    if (!editor || editor.document.languageId !== "latex") {
        const blocked = context.scopes.some(s => /comment|verbatim|listing/.test(s));
        return { mode: blocked ? "code" : context.scopes.some(s => s.startsWith("meta.math")) ? "math" : "text", command: false };
    }
    const document = editor.document;
    const position = editor.selection.active;
    const offset = document.offsetAt(position);
    if (!cachedState || cachedState.document !== document || cachedState.version !== document.version || cachedState.offset !== offset) {
        const before = document.getText(new vscode.Range(new vscode.Position(0, 0), position));
        cachedState = { document, version: document.version, offset, value: scanLatex(before) };
    }
    return cachedState.value;
}
function math(context) { return state(context).mode === "math"; }
function mathShortcut(context) { const s = state(context); return s.mode === "math" && !s.command; }
function text(context) { const s = state(context); return s.mode === "text" && !s.command; }
function editable(context) { return !["code", "comment"].includes(state(context).mode); }
// VS Code consumes \\ and \} in snippet text. Preserve literal TeX data
// captured from the document or generated as matrix row breaks.
function snippetText(value) { return value.replace(/\\(?=[\\}])/g, "\\\\"); }
endglobal

# Enter math from text. Tab advances placeholders; Shift+Tab goes back.

context text(context)
snippet `(?<![A-Za-z])mk` "Inline math" A
\($1\)$0
endsnippet

context text(context)
snippet `(?<![A-Za-z])dm` "Display math" A
\[
    $1
\]
$0
endsnippet

priority -50
context editable(context)
snippet `(?<!\\)\(` "Paired ()" A
($1)$0
endsnippet

priority -50
context editable(context)
snippet `(?<!\\)\[` "Paired []" A
[$1]$0
endsnippet

priority -50
context editable(context)
snippet `(?<!\\)\{` "Paired {}" A
{$1}$0
endsnippet

priority -50
context text(context)
snippet `(?<!\\)"` "Paired text quotes" A
"$1"$0
endsnippet

context text(context)
snippet beg "Environment (choose its name)" w
\begin{$1}
    $2
\end{``rv = t[0]``}
$0
endsnippet

context mathShortcut(context)
snippet `(?<![A-Za-z])beg` "Math environment (choose its name)" A
\begin{$1}
    $2
\end{``rv = t[0]``}$0
endsnippet

