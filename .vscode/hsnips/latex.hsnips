# Automatic fractions for atoms, scripts, function calls, and grouped sums.

priority 80
context mathShortcut(context)
snippet `(?<![A-Za-z0-9_\\])((?:(?:\\[A-Za-z]+(?: ?\{(?:[^{}\n]|\{(?:[^{}\n]|\{(?:[^{}\n]|\{[^{}\n]*\})*\})*\})*\})*|[A-Za-z0-9]+)(?: ?[_^](?:\{(?:[^{}\n]|\{(?:[^{}\n]|\{(?:[^{}\n]|\{[^{}\n]*\})*\})*\})*\}|[A-Za-z0-9])| ?\((?:[^()\n]|\((?:[^()\n]|\((?:[^()\n]|\([^()\n]*\))*\))*\))*\))*|\((?:[^()\n]|\((?:[^()\n]|\((?:[^()\n]|\([^()\n]*\))*\))*\))*\)))/` "Auto fraction: numerator /" A
\frac{``rv = snippetText(m[1].startsWith('(') ? m[1].slice(1, -1) : m[1])``}{$1}$0
endsnippet

