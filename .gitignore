# Ignore files by default; keep directories traversable so allowed files
# can be included from nested folders.
*
!*/
!.gitignore

# TeX source and style files
!*.tex
!*.sty

# Workspace-local VS Code LaTeX shortcuts
!.vscode/*.json
!.vscode/hsnips/*.hsnips
!.vscode/hsnips/README.md
!.vscode/hsnips/check-snippets.cjs
!.vscode/hsnips/LICENSE.latex-suite.txt

# Figure files (PDFs are intentionally excluded)
!*.png
!*.jpg
!*.jpeg
!*.gif
!*.svg
!*.eps
!*.tif
!*.tiff
!*.webp

# Keep the block reference beside the notes; lecture PDFs remain excluded.
!/typesetting-block-reference.pdf
